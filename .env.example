# ldgr environment template
# Copy to .env and fill in what you use. Every variable here configures
# host-side tooling only. Simulation code never reads the environment;
# the engine enforces this with ledger-lint.

# --- ldgr-rt IPC ---
# Absolute path to the engine binary that hosts simulation workloads over
# the IPC boundary. The facade spawns this binary and talks over UDS.
# LEDGER_ENGINE_BIN=/usr/local/bin/ldgr-engine

# --- Worker ---
# Bearer token for artifact publication from ledger-worker.
# LEDGER_ARTIFACT_TOKEN=ldgr_pat_xxxxxxxxxxxxxxxx
# Private socket directory for the worker UDS endpoint. When XDG_RUNTIME_DIR
# is set, the worker prefers it; otherwise it falls back to the system temp
# directory. Override only when you run the worker in a container.
# XDG_RUNTIME_DIR=/run/user/1000

# --- Sentinel (Linux-only, opt-in) ---
# Belt mode for ambient-API trapping inside simulation. The belt and the
# linter are complementary; prefer the effects boundary for portability.
# LEDGER_SENTINEL_BELT=strict
# Probe mode for the sentinel probe binary. Used by the self-check harness.
# LEDGER_PROBE_MODE=wall-clock

# --- Tokio backend virtual time (host shim) ---
# File that carries the virtual tick counter for the Tokio shim. The shim
# reads and advances this file instead of the wall clock.
# LEDGER_VIRTUAL_TICKS_PATH=/tmp/ldgr-ticks
# Hex-encoded seed that pins the virtual-time stream for the run.
# LEDGER_VIRTUAL_SEED_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Nightly campaign example ---
# Builder identity stamped into nightly certificates and provenance.
# LEDGER_BUILDER_ID=nightly-swarm-campaign
# Fingerprint of the builder profile used for the run. The helper falls back
# to nightly-swarm-campaign when this is unset.
# LEDGER_PROFILE_FINGERPRINT=ci-runner-01
# Output path for the campaign certificate JSON. When set, the example writes
# the certificate to this file.
# LEDGER_CERT_OUT=./artifacts/cert.json
